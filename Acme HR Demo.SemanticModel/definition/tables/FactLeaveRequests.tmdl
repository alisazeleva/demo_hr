/// One row per leave request of any status (vw_LeaveRequests); used for pending requests and the absent-today list
table FactLeaveRequests
	lineageTag: b1a5fa72-fbbd-4400-910e-15399e2e3e54

	column EmployeeID
		dataType: int64
		isHidden
		lineageTag: 82153efa-31d5-48a9-9c8e-cf1fc1074e99
		summarizeBy: none
		sourceColumn: EmployeeID

	column LeaveTypeID
		dataType: int64
		isHidden
		lineageTag: 7034f6cc-2869-4fdc-bbea-81b079bebde2
		summarizeBy: none
		sourceColumn: LeaveTypeID

	column Status
		dataType: string
		lineageTag: 3fe6ddad-b705-49e3-9b2d-7665989c5316
		summarizeBy: none
		sourceColumn: Status

	column StartDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: e9c583a6-ebb5-4d5d-9ac1-64e032182293
		summarizeBy: none
		sourceColumn: StartDate

		annotation UnderlyingDateTimeDataType = Date

	column EndDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: a954f450-72c5-4f99-8a4c-f41ee9eac88a
		summarizeBy: none
		sourceColumn: EndDate

		annotation UnderlyingDateTimeDataType = Date

	/// True when the request is approved and covers the reference date (the people absent today). Computed from the reference date in the data, not from today's date.
	column IsAbsentToday =
			VAR ref = MAX(ReferenceDate[ReferenceDate])
			RETURN FactLeaveRequests[Status] = "Approved" && FactLeaveRequests[StartDate] <= ref && FactLeaveRequests[EndDate] >= ref
		dataType: boolean
		lineageTag: a1b8048e-ea9a-47af-b6e4-afdbdd84f3ea
		summarizeBy: none

	/// True when the request is approved, has not ended on the reference date and starts no later than the last day of the absence window (30 days after the reference date): the people absent today plus the approved absences of the next 30 days. Computed from the reference date in the data, not from today's date.
	column IsInAbsenceWindow =
			// Approved leave that is not over on the reference date and starts inside the window (see Absence Window End Date).
			VAR ref = MAX(ReferenceDate[ReferenceDate])
			VAR lastDay = [Absence Window End Date]
			RETURN
			    FactLeaveRequests[Status] = "Approved"
			        && FactLeaveRequests[EndDate] >= ref
			        && FactLeaveRequests[StartDate] <= lastDay
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 7b2e9f40-6c1d-4a35-8e17-93d5a0c4b6f2
		summarizeBy: none

	partition LeaveRequests = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    Data = Source{[Schema="dbo", Item="vw_LeaveRequests"]}[Data],
				    // a request exists from its request date; it is Pending until its decision date, then Approved or Rejected
				    Visible = Table.SelectRows(Data, each [RequestDate] = null or [RequestDate] <= ReferenceDateValue),
				    AsOf = Table.AddColumn(Table.RenameColumns(Visible, {{"Status", "FinalStatus"}}), "Status", each if [DecisionDate] <> null and [DecisionDate] > ReferenceDateValue then "Pending" else [FinalStatus], type text),
				    Slim = Table.RemoveColumns(AsOf, {"LeaveID", "DepartmentID", "RequestDate", "DecisionDate", "FinalStatus"}, MissingField.Ignore)
				in
				    Slim

	annotation PBI_ResultType = Table

