/// Annual performance reviews (vw_PerformanceReviews)
table FactReviews
	lineageTag: 181228c8-04e7-431e-8876-7cfa22949f8a

	column EmployeeID
		dataType: int64
		isHidden
		lineageTag: 066eb01e-6000-4d30-a5c8-41c9b6f633f5
		summarizeBy: none
		sourceColumn: EmployeeID

	column ReviewerName
		dataType: string
		lineageTag: d3f2ef92-35c2-448f-a175-9f0f14bd1a01
		summarizeBy: none
		sourceColumn: ReviewerName

		annotation SummarizationSetBy = Automatic

	column ReviewYear
		dataType: int64
		lineageTag: 5af00836-b22a-4c0b-a613-595e6a9ee779
		summarizeBy: sum
		sourceColumn: ReviewYear

		annotation SummarizationSetBy = Automatic

	column ReviewDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: de6713c8-9b35-4251-b5e5-2b74043ba94b
		summarizeBy: none
		sourceColumn: ReviewDate

		annotation UnderlyingDateTimeDataType = Date

	column Rating
		dataType: double
		formatString: 0.0
		lineageTag: b0d3d2c1-80d7-4a20-b705-a35daa07c714
		summarizeBy: sum
		sourceColumn: Rating

		annotation SummarizationSetBy = Automatic

	column Level
		dataType: string
		lineageTag: 1d7ad926-b12c-4c50-a5cf-de6bb9e64d20
		summarizeBy: none
		sourceColumn: Level
		sortByColumn: 'Level Order'

		annotation SummarizationSetBy = Automatic

	column Comments
		dataType: string
		lineageTag: 067ba860-622d-4f1a-bdd7-2d90c63dbb54
		summarizeBy: none
		sourceColumn: Comments

		annotation SummarizationSetBy = Automatic

	/// Sort order of Level: 1 Needs Improvement to 4 Outstanding. Derived from Rating with the thresholds in PLAN.md (below 2.5, below 3.5, below 4.5, 4.5 or more); derived from Rating, not Level, so Level can be sorted by it.
	column 'Level Order' = SWITCH(TRUE(), FactReviews[Rating] < 2.5, 1, FactReviews[Rating] < 3.5, 2, FactReviews[Rating] < 4.5, 3, 4)
		dataType: int64
		isHidden
		lineageTag: c880f123-ffae-42b3-bb32-6c76fa46c65e
		summarizeBy: none

	column 'Level Long' = [Level] & " ("& SWITCH([Level], "Needs Improvement", "NI", "Meets Expectations", "ME", "Exceeds Expectations", "EE", "Outstanding", "O") & ")"
		lineageTag: 6a881733-8b37-4238-8f71-cb6ab21e1bf1
		summarizeBy: none
		sortByColumn: 'Level Order'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	partition Reviews = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    Data = Source{[Schema="dbo", Item="vw_PerformanceReviews"]}[Data],
				    Slim = Table.RemoveColumns(Data, {"ReviewPeriodStart", "ReviewPeriodEnd", "PerformanceReviewID", "ReviewerID", "IsRecentReview", "PositionID", "DepartmentID"}, MissingField.Ignore)
				in
				    Slim

