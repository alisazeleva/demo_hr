	/// Rank of the nationality by headcount (1 = largest, ties by name); 99 = grouped into Other (outside the top 6)
	column 'Nationality Order' =
			VAR nat = DimEmployee[Nationality]
			VAR counts = GROUPBY(ALL(DimEmployee), DimEmployee[Nationality], "@c", COUNTX(CURRENTGROUP(), 1))
			VAR cnt = MAXX(FILTER(counts, DimEmployee[Nationality] = nat), [@c])
			VAR higher = COUNTROWS(FILTER(counts, [@c] > cnt || ([@c] = cnt && DimEmployee[Nationality] < nat)))
			RETURN IF(higher < 6, higher + 1, 99)
		dataType: int64
		isHidden
		lineageTag: 94fa24ec-b5c6-4c2c-9208-e5cd4ab28487
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Rank of the native language by headcount (1 = largest, ties by name); 99 = grouped into Other (outside the top 6)
	column 'Native Language Order' =
			VAR lang = DimEmployee[NativeLanguage]
			VAR counts = GROUPBY(ALL(DimEmployee), DimEmployee[NativeLanguage], "@c", COUNTX(CURRENTGROUP(), 1))
			VAR cnt = MAXX(FILTER(counts, DimEmployee[NativeLanguage] = lang), [@c])
			VAR higher = COUNTROWS(FILTER(counts, [@c] > cnt || ([@c] = cnt && DimEmployee[NativeLanguage] < lang)))
			RETURN IF(higher < 6, higher + 1, 99)
		dataType: int64
		isHidden
		lineageTag: dbea55b1-e6a6-4937-88ad-f9bad5191789
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Nationality for the six largest groups, everything else as Other
	column 'Nationality Top 6' = IF(DimEmployee[Nationality Order] = 99, "Other (" & (COUNTROWS(ALL(DimEmployee[Nationality])) - 6) & ")", DimEmployee[Nationality])
		dataType: string
		lineageTag: e50a0bd0-cf11-4d6e-aa97-6485f31be90a
		summarizeBy: none
		sortByColumn: 'Nationality Order'

	/// Native language for the six largest groups, everything else as Other
	column 'Native Language Top 6' = IF(DimEmployee[Native Language Order] = 99, "Other (" & (COUNTROWS(ALL(DimEmployee[NativeLanguage])) - 6) & ")", DimEmployee[NativeLanguage])
		dataType: string
		lineageTag: a7f33dd5-89ad-44ad-a707-49682f76a2e2
		summarizeBy: none
		sortByColumn: 'Native Language Order'

	/// Initials of the latest performance level: NI Needs Improvement, ME Meets Expectations, EE Exceeds Expectations, O Outstanding. Blank when the employee has no review.
	column 'Latest Level Short' = SWITCH(DimEmployee[LatestPerformanceLevel], "Needs Improvement", "NI", "Meets Expectations", "ME", "Exceeds Expectations", "EE", "Outstanding", "O")
		dataType: string
		lineageTag: 274b3979-a11b-4ce3-954d-eeaccbb5c353
		summarizeBy: none

	partition Employees = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    People = Source{[Schema="dbo", Item="vw_DimEmployee"]}[Data],
				    Hired = Table.SelectRows(People, each [HireDate] <= ReferenceDateValue),
				    // position, department and manager: the job row that covers the reference date
				    Jobs = Source{[Schema="dbo", Item="vw_JobHistory"]}[Data],
				    Job = Table.SelectRows(Jobs, each [EffectiveDate] <= ReferenceDateValue and ([EndDate] = null or [EndDate] > ReferenceDateValue)),
				    JobCols = Table.RenameColumns(Table.SelectColumns(Job, {"EmployeeID", "PositionID", "DepartmentID", "ManagerID"}), {{"EmployeeID", "JobEmployeeID"}, {"ManagerID", "ManagerEmployeeID"}}),
				    WithJob = Table.Join(Hired, "EmployeeID", JobCols, "JobEmployeeID", JoinKind.LeftOuter),
				    // salary: the pay row that covers the reference date
				    PayRows = Source{[Schema="dbo", Item="vw_CompensationHistory"]}[Data],
				    PayNow = Table.SelectRows(PayRows, each [EffectiveDate] <= ReferenceDateValue and ([EndDate] = null or [EndDate] > ReferenceDateValue)),
				    Pay = Table.RenameColumns(Table.SelectColumns(PayNow, {"EmployeeID", "Salary"}), {{"EmployeeID", "PayEmployeeID"}, {"Salary", "CurrentSalary"}}),
				    WithPay = Table.Join(WithJob, "EmployeeID", Pay, "PayEmployeeID", JoinKind.LeftOuter),
				    // latest review dated on or before the reference date
				    Reviews = Source{[Schema="dbo", Item="vw_PerformanceReviews"]}[Data],
				    Dated = Table.SelectRows(Reviews, each [ReviewDate] <= ReferenceDateValue),
				    Latest = Table.Group(Dated, {"EmployeeID"}, {{"Last", each Table.Max(_, "ReviewPeriodEnd"), type record}}),
				    LatestCols = Table.AddColumn(Table.AddColumn(Table.AddColumn(Latest, "LatestRating", each [Last][Rating], type number), "LatestReviewDate", each [Last][ReviewDate], type date), "LatestPerformanceLevel", each [Last][Level], type text),
				    LatestSlim = Table.RenameColumns(Table.SelectColumns(LatestCols, {"EmployeeID", "LatestRating", "LatestReviewDate", "LatestPerformanceLevel"}), {{"EmployeeID", "ReviewEmployeeID"}}),
				    WithReview = Table.Join(WithPay, "EmployeeID", LatestSlim, "ReviewEmployeeID", JoinKind.LeftOuter),
				    // direct reports on the reference date
				    Reports = Table.Group(Table.SelectRows(WithJob, each [ManagerEmployeeID] <> null), {"ManagerEmployeeID"}, {{"DirectReports", each Table.RowCount(_), Int64.Type}}),
				    ReportsRen = Table.RenameColumns(Reports, {{"ManagerEmployeeID", "ReportsManagerID"}}),
				    WithReports = Table.Join(WithReview, "EmployeeID", ReportsRen, "ReportsManagerID", JoinKind.LeftOuter),
				    Zero = Table.TransformColumns(WithReports, {{"DirectReports", each if _ = null then 0 else _, Int64.Type}}),
				    // age and tenure on the reference date
				    Aged = Table.AddColumn(Zero, "Age", each Date.Year(ReferenceDateValue) - Date.Year([DateOfBirth]) - (if Date.AddYears([DateOfBirth], Date.Year(ReferenceDateValue) - Date.Year([DateOfBirth])) > ReferenceDateValue then 1 else 0), Int64.Type),
				    Tenure = Table.AddColumn(Aged, "TenureYears", each Number.Round(Duration.Days(ReferenceDateValue - [HireDate]) / 365.25, 2), type number),
				    Slim = Table.RemoveColumns(Tenure, {"FirstName", "LastName", "EmailAddress", "DateOfBirth", "JobEmployeeID", "PayEmployeeID", "ReviewEmployeeID", "ReportsManagerID"}, MissingField.Ignore)
				in
				    Slim

	annotation PBI_ResultType = Table

