	partition JobHistory = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    Data = Source{[Schema="dbo", Item="vw_JobHistory"]}[Data],
				    Started = Table.SelectRows(Data, each [EffectiveDate] <= ReferenceDateValue),
				    Open = Table.TransformColumns(Started, {{"EndDate", each if _ <> null and _ <= ReferenceDateValue then _ else null, type nullable date}}),
				    Current = Table.AddColumn(Table.RemoveColumns(Open, {"IsCurrent"}), "IsCurrent", each [EndDate] = null, type logical),
				    Slim = Table.RemoveColumns(Current, {"JobHistoryID", "EndDate", "IsCurrent", "Reason", "PositionID", "DepartmentID", "ManagerID", "PrevPositionID", "PrevDepartmentID", "PrevDepartment", "PrevManagerID", "PrevManagerName"}, MissingField.Ignore)
				in
				    Slim

	annotation PBI_ResultType = Table

