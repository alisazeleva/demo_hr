/// Employees who manage a team: the manager role of an employee (vw_DimManager)
table DimManager
	lineageTag: 07bba801-b27f-4333-8f13-9b94bb8175f2

	column ManagerEmployeeID
		dataType: int64
		isHidden
		lineageTag: 05bf8384-1462-4435-8c8c-ae82c02da846
		summarizeBy: none
		sourceColumn: ManagerEmployeeID

	column ManagerName
		dataType: string
		lineageTag: 24555b9f-c97e-460c-8f20-591d84e1bfd5
		summarizeBy: none
		sourceColumn: ManagerName

		annotation SummarizationSetBy = Automatic

	partition Manager = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    Data = Source{[Schema="dbo", Item="vw_DimManager"]}[Data],
				    Jobs = Source{[Schema="dbo", Item="vw_JobHistory"]}[Data],
				    // people who have direct reports on the reference date (job rows that cover it)
				    Current = Table.SelectRows(Jobs, each [EffectiveDate] <= ReferenceDateValue and ([EndDate] = null or [EndDate] > ReferenceDateValue)),
				    Managers = List.Distinct(List.RemoveNulls(Current[ManagerID])),
				    Active = Table.SelectRows(Data, each List.Contains(Managers, [ManagerEmployeeID])),
				    Slim = Table.RemoveColumns(Active, {"ManagerNumber"}, MissingField.Ignore)
				in
				    Slim

	annotation PBI_ResultType = Table

