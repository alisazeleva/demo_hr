/// The reference date (today) from vw_ReferenceDate: the single source for all date-relative measures
table ReferenceDate
	lineageTag: 44868812-afec-484b-b37a-52f3f18d7118

	column ReferenceDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: f87915f1-b8ba-497e-92b5-d4ef9a753683
		summarizeBy: none
		sourceColumn: ReferenceDate

		annotation UnderlyingDateTimeDataType = Date

	partition ReferenceDate = m
		mode: import
		queryGroup: 'Reference Date'
		source =
				let
				    Source = #table(type table [ReferenceDate = date], {{ReferenceDateValue}})
				in
				    Source

	annotation PBI_ResultType = Table

