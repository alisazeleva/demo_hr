/// One row per working day of every approved leave (vw_LeaveDays)
table FactLeaveDays
	lineageTag: 8900a3a4-2573-4496-a226-893941b6917f

	column EmployeeID
		dataType: int64
		isHidden
		lineageTag: 9e293afd-f519-4007-a3d3-c34eb8f9bc80
		summarizeBy: none
		sourceColumn: EmployeeID

	column LeaveDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 09665756-1573-4a48-9018-41b1cad25e5a
		summarizeBy: none
		sourceColumn: LeaveDate

		annotation UnderlyingDateTimeDataType = Date

	column IsOnOrBeforeReferenceDate
		dataType: boolean
		lineageTag: 5edfae1d-0792-43e6-8153-4c97b04e0dcf
		summarizeBy: none
		sourceColumn: IsOnOrBeforeReferenceDate

		annotation SummarizationSetBy = Automatic

	column LeaveTypeID
		dataType: int64
		isHidden
		lineageTag: d83cb5a6-703e-4a76-af8a-617c5c7e3277
		summarizeBy: none
		sourceColumn: LeaveTypeID

	partition LeaveDays = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    Data = Source{[Schema="dbo", Item="vw_LeaveDays"]}[Data],
				    // days count once the leave is approved (on its decision date); booked future days are kept
				    Decided = Table.SelectRows(Data, each [DecisionDate] = null or [DecisionDate] <= ReferenceDateValue),
				    Flag = Table.AddColumn(Decided, "IsOnOrBeforeReferenceDate", each [LeaveDate] <= ReferenceDateValue, type logical),
				    Slim = Table.RemoveColumns(Flag, {"LeaveID", "DepartmentID", "RequestDate", "DecisionDate"}, MissingField.Ignore)
				in
				    Slim

	annotation PBI_ResultType = Exception

