/// Salary periods with the previous salary and change (vw_CompensationHistory)
table FactCompensation
	lineageTag: a8f80377-173b-40c0-9925-707d1e059464

	column EmployeeID
		dataType: int64
		isHidden
		lineageTag: 3a0cfe3b-d226-4502-9df0-999ff8ede841
		summarizeBy: none
		sourceColumn: EmployeeID

	column EffectiveDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: e700389e-def3-4067-bb93-ba08ba8aa09a
		summarizeBy: none
		sourceColumn: EffectiveDate

		annotation UnderlyingDateTimeDataType = Date

	column EndDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 75fb71b1-59e1-4dbe-b5dc-8bc7aff5c028
		summarizeBy: none
		sourceColumn: EndDate

		annotation UnderlyingDateTimeDataType = Date

	column IsCurrent
		dataType: boolean
		lineageTag: 2a7af0e4-5902-4ec5-b571-7a5e6c23e31a
		summarizeBy: none
		sourceColumn: IsCurrent

		annotation SummarizationSetBy = Automatic

	column Salary
		dataType: double
		formatString: #,0
		lineageTag: 8cb55503-a973-49ae-ba96-713f8d867881
		summarizeBy: sum
		sourceColumn: Salary

		annotation SummarizationSetBy = Automatic

	column ChangePct
		dataType: double
		formatString: 0.00
		lineageTag: 7efc9891-9df9-43e1-9dc1-ba3ffa10cd2e
		summarizeBy: sum
		sourceColumn: ChangePct

		annotation SummarizationSetBy = Automatic

	column Reason
		dataType: string
		lineageTag: b5546eaf-77ef-4675-9b3f-822febf93947
		summarizeBy: none
		sourceColumn: Reason

		annotation SummarizationSetBy = Automatic

	partition Compensation = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    Data = Source{[Schema="dbo", Item="vw_CompensationHistory"]}[Data],
				    Started = Table.SelectRows(Data, each [EffectiveDate] <= ReferenceDateValue),
				    // the row that covers the reference date is open: EndDate empty and IsCurrent true
				    Open = Table.TransformColumns(Started, {{"EndDate", each if _ <> null and _ <= ReferenceDateValue then _ else null, type nullable date}}),
				    Current = Table.AddColumn(Table.RemoveColumns(Open, {"IsCurrent"}), "IsCurrent", each [EndDate] = null, type logical),
				    Slim = Table.RemoveColumns(Current, {"Currency", "PayFrequency", "CompensationHistoryID", "PreviousSalary", "ChangeAmount"}, MissingField.Ignore)
				in
				    Slim

	annotation PBI_ResultType = Table

