{
  "name": "Acme HR",
  "dataColors": [
    "#2563EB",
    "#0E9F8E",
    "#D9822B",
    "#7C5CD6",
    "#C8446A",
    "#4A6FA5",
    "#E0A030",
    "#14213D",
    "#5B6472",
    "#CBD5E1"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "foregroundNeutralSecondary": "#5B6472",
  "foregroundNeutralTertiary": "#CBD5E1",
  "tableAccent": "#2563EB",
  "good": "#0E9F8E",
  "neutral": "#D9822B",
  "bad": "#C8446A",
  "minimum": "#E6EDFA",
  "center": "#8FAEE8",
  "maximum": "#2563EB",
  "hyperlink": "#2563EB",
  "visitedHyperlink": "#5B6472",
  "textClasses": {
    "callout": { "fontSize": 42, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "title": { "fontSize": 20, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "header": { "fontSize": 16, "fontFace": "Segoe UI Semibold", "color": "#1F2937" },
    "label": { "fontSize": 16, "fontFace": "Segoe UI", "color": "#1F2937" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          { "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }
        ],
        "border": [
          { "show": true, "color": { "solid": { "color": "#E5E7EB" } }, "radius": 15 }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 20,
            "fontColor": { "solid": { "color": "#1F2937" } },
            "alignment": "left"
          }
        ],
        "visualTooltip": [
          { "fontSize": 10, "fontFamily": "Segoe UI" }
        ],
        "subTitle": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 16,
            "fontColor": { "solid": { "color": "#5B6472" } }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          { "color": { "solid": { "color": "#F3F4F6" } }, "transparency": 0 }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 42,
            "fontFamily": "Segoe UI Semibold",
            "color": { "solid": { "color": "#1F2937" } }
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "fontSize": 18,
            "fontFamily": "Segoe UI",
            "color": { "solid": { "color": "#5B6472" } }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 16,
            "fontColor": { "solid": { "color": "#5B6472" } }
          }
        ],
        "items": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 16,
            "fontColor": { "solid": { "color": "#1F2937" } }
          }
        ]
      }
    }
  }
}
