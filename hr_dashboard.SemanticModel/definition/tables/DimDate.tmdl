/// Calendar 2012-01-01 to 2027-12-31 (PLAN.md)
table DimDate
	lineageTag: fac3adc9-ad12-486e-8d30-1663c1895fe3
	dataCategory: Time

	column Date
		isUnique
		formatString: yyyy-mm-dd
		lineageTag: 1da90d3e-4a66-4393-97b2-fe7b4806f5ea
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	column Year
		formatString: 0
		lineageTag: 7c5324ab-306d-44b0-9c9e-8d5cd048f187
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column Quarter
		lineageTag: aa6c793e-2bb9-4c7c-be3a-387f694b265e
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

		annotation SummarizationSetBy = Automatic

	column 'Month Number'
		isHidden
		lineageTag: 785141b2-af20-41e0-b986-6b10ddda711d
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Month Number]

		annotation SummarizationSetBy = Automatic

	column Month
		lineageTag: e2c5e35d-0370-4749-83be-c61e1c4e1cdb
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month Number'

		annotation SummarizationSetBy = Automatic

	column Year-Month
		lineageTag: a9b5110f-f7e6-41c0-a60f-7b6beb11ae02
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year-Month]

		annotation SummarizationSetBy = Automatic

	column 'Weekday Number'
		isHidden
		lineageTag: 5de83c06-5bfb-4bc1-a5fb-c938889c8aee
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Weekday Number]

		annotation SummarizationSetBy = Automatic

	column Weekday
		lineageTag: 3b0b5ca6-2d7b-4aa4-9bae-08faf8bd2e57
		summarizeBy: none
		isNameInferred
		sourceColumn: [Weekday]
		sortByColumn: 'Weekday Number'

		annotation SummarizationSetBy = Automatic

	partition Date = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(2012, 1, 1), DATE(2027, 12, 31)),
				    "Year", YEAR([Date]),
				    "Quarter", "Q" & QUARTER([Date]),
				    "Month Number", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "Year-Month", FORMAT([Date], "YYYY-MM"),
				    "Weekday Number", WEEKDAY([Date], 2),
				    "Weekday", FORMAT([Date], "ddd")
				)

