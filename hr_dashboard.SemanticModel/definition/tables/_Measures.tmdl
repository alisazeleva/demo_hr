/// Holder table for the report measures (PLAN.md, Measures)
table _Measures
	lineageTag: 2c81652f-52f6-4669-b165-de60bf05f204

	/// The reference date (today), read from vw_ReferenceDate
	measure 'Reference Date' = MAX(ReferenceDate[ReferenceDate])
		formatString: yyyy-mm-dd
		displayFolder: Helpers
		lineageTag: 07cf75f8-b983-417e-b34b-f805ad62582c

	/// Number of employees in the current filter (151 in total, including the CEO)
	measure Headcount = COUNTROWS(DimEmployee)
		formatString: #,0
		displayFolder: Workforce
		lineageTag: 4c3dcaba-f1fe-4874-95ad-34c37f0a5b62

	/// Employees in the five departments (excludes the CEO, who sits under Acme Corporation)
	measure 'Department Headcount' = CALCULATE([Headcount], DimPosition[JobLevel] <> "CEO")
		formatString: #,0
		displayFolder: Workforce
		lineageTag: a66e7598-dcde-4a1e-9d33-cdf175145b22

	/// Planned headcount of the departments in the current employee filter
	measure 'Target Headcount' =
			CALCULATE(
			    SUM(FactWorkforcePlan[TargetHeadcount]),
			    TREATAS(VALUES(DimEmployee[DepartmentID]), FactWorkforcePlan[DepartmentID])
			)
		formatString: #,0
		displayFolder: Workforce
		lineageTag: 2aba32ae-24ca-4e58-af91-3986e603831d

	/// Department headcount minus target headcount (0 = on target)
	measure 'Headcount vs Target' = ```
			[Target Headcount] - [Department Headcount]
			
			```
		formatString: 0
		displayFolder: Workforce
		lineageTag: 6469f3eb-bd7d-4c2d-98f1-b3f907a58a5c

	/// Average years of service on the reference date
	measure 'Average Tenure (years)' = AVERAGE(DimEmployee[TenureYears])
		formatString: 0.0" years"
		displayFolder: Workforce
		lineageTag: c7bc268b-c549-4704-9dac-63db9c3a18e1

	/// Direct reports of the employees in the current filter
	measure 'Direct Reports' = SUM(DimEmployee[DirectReports])
		formatString: #,0
		displayFolder: Organization
		lineageTag: 103fef50-1b53-48ac-9109-d1adeac79706

	/// Employees who have at least one direct report
	measure Managers = CALCULATE(COUNTROWS(DimEmployee), DimEmployee[DirectReports] > 0)
		formatString: #,0
		displayFolder: Organization
		lineageTag: 82f235cb-b0fb-4738-bd4b-1562b6704e09

	/// Promotions (including promotions with a department transfer), by promotion date
	measure Promotions = CALCULATE(COUNTROWS(FactJobHistory), FactJobHistory[IsPromotion] = TRUE())
		formatString: #,0
		displayFolder: Career
		lineageTag: 16d7bda0-12ae-4323-b134-03d6d9a90b52

	/// Department transfers (including promotions with a transfer), by transfer date
	measure 'Department Transfers' = CALCULATE(COUNTROWS(FactJobHistory), FactJobHistory[IsDepartmentTransfer] = TRUE())
		formatString: #,0
		displayFolder: Career
		lineageTag: 0c5d85b3-28b0-4887-af77-3e7ff8c97f83

	/// Average months in the job before a promotion: from the previous promotion, or from hire for a first promotion, to the promotion date. Every promoted employee contributes, so every department has a value.
	measure 'Average Months Before Promotion' =
			AVERAGEX(
			    FILTER(FactJobHistory, FactJobHistory[IsPromotion] = TRUE()),
			    VAR emp = FactJobHistory[EmployeeID]
			    VAR d = FactJobHistory[EffectiveDate]
			    VAR prevPromo =
			        CALCULATE(
			            MAX(FactJobHistory[EffectiveDate]),
			            FILTER(ALL(FactJobHistory), FactJobHistory[EmployeeID] = emp && FactJobHistory[IsPromotion] = TRUE() && FactJobHistory[EffectiveDate] < d)
			        )
			    VAR hired =
			        CALCULATE(
			            MIN(FactJobHistory[EffectiveDate]),
			            FILTER(ALL(FactJobHistory), FactJobHistory[EmployeeID] = emp)
			        )
			    RETURN DATEDIFF(IF(ISBLANK(prevPromo), hired, prevPromo), d, MONTH)
			)
		formatString: 0.0
		displayFolder: Career
		lineageTag: a660e71a-128b-4fcb-92d7-c6b25abf770e

	/// Average current annual base salary (EUR)
	measure 'Average Salary' = AVERAGE(DimEmployee[CurrentSalary])
		formatString: "€"#,0
		displayFolder: Compensation
		lineageTag: ea466c53-7b19-44a5-a489-79c622e6a087

	/// Average annual review rating (1.0 to 5.0)
	measure 'Average Rating' = AVERAGE(FactReviews[Rating])
		formatString: 0.00
		displayFolder: Performance
		lineageTag: d7a4de2f-ba41-4413-982c-0841b7ce1fb8

	/// Employees with no review in the 12 months before the reference date (includes the CEO and recent hires)
	measure 'Employees Without Recent Review' =
			VAR ref = [Reference Date]
			RETURN
			CALCULATE(
			    COUNTROWS(DimEmployee),
			    FILTER(DimEmployee, ISBLANK(DimEmployee[LatestReviewDate]) || DimEmployee[LatestReviewDate] <= EDATE(ref, -12))
			)
		formatString: #,0
		displayFolder: Performance
		lineageTag: 7b9fc68c-9e17-49be-b01a-85f7de1feaea

	/// Working days of approved leave
	measure 'Leave Days' = COUNTROWS(FactLeaveDays)
		formatString: #,0
		displayFolder: Leave
		lineageTag: aa90eb6a-37a6-496f-89b5-b6f7e2cc3911

	/// Approved vacation days on or before the reference date
	measure 'Vacation Days Used' = CALCULATE(COUNTROWS(FactLeaveDays), DimLeaveType[LeaveType] = "Vacation", FactLeaveDays[IsOnOrBeforeReferenceDate] = TRUE())
		formatString: #,0
		displayFolder: Leave
		lineageTag: 786de8ef-8478-4196-928c-03e963678c90

	/// Vacation days used per employee in the selected year(s): used days divided by employees hired by the end of the period. Use with a Year slicer or axis.
	measure 'Vacation Days Used per Year' =
			DIVIDE(
			    [Vacation Days Used],
			    CALCULATE(COUNTROWS(DimEmployee), DimEmployee[HireDate] <= MAX('DimDate'[Date]))
			)
		formatString: 0.0
		displayFolder: Leave
		lineageTag: 9b6a589d-dd13-4b49-a9be-63f88bb77d21

	/// Employees on approved leave on the reference date (ignores the Date filter)
	measure 'Currently Absent' =
			VAR ref = [Reference Date]
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(FactLeaveDays[EmployeeID]),
			    REMOVEFILTERS('DimDate'),
			    FactLeaveDays[LeaveDate] = ref
			)
		formatString: #,0
		displayFolder: Leave
		lineageTag: fbf39e58-6728-45d7-b659-2b2ed02a282f

	/// Employees hired in the selected period (counts by hire date through the inactive DimEmployee[HireDate] to DimDate relationship)
	measure Hires = CALCULATE(COUNTROWS(DimEmployee), USERELATIONSHIP(DimEmployee[HireDate], 'DimDate'[Date]))
		formatString: #,0
		displayFolder: Workforce
		lineageTag: 6de13a3d-2b09-487d-9e23-aafd92ae1540

	/// Average age in years on the reference date
	measure 'Average Age' = AVERAGE(DimEmployee[Age])
		formatString: 0.0" years"
		displayFolder: Workforce
		lineageTag: c618d38d-15c1-4c5e-ba1f-3ee110dbc158

	/// Share of female employees in the current filter
	measure 'Female Share' = DIVIDE(CALCULATE(COUNTROWS(DimEmployee), DimEmployee[Gender] = "Female"), COUNTROWS(DimEmployee))
		formatString: 0.0%
		displayFolder: Workforce
		lineageTag: d2b20400-9ae2-482a-aa4e-f7c0f680496a

	/// Median current annual base salary (EUR)
	measure 'Median Salary' = MEDIAN(DimEmployee[CurrentSalary])
		formatString: "€"#,0
		displayFolder: Compensation
		lineageTag: 209e92d4-13dc-4356-8709-3e6ac9d27971

	/// Sum of current annual base salaries (EUR per year)
	measure 'Total Payroll' = SUM(DimEmployee[CurrentSalary])
		formatString: "€"#,0
		displayFolder: Compensation
		lineageTag: 8b0a6cbd-e159-4d2a-af1b-c5b08755935b

	/// Approved vacation working days on or before the reference date divided by headcount
	measure 'Vacation Days Used per Employee' = DIVIDE([Vacation Days Used], [Headcount])
		formatString: 0.0
		displayFolder: Leave
		lineageTag: fd6075a1-eb20-44ce-bd55-928ac21b92b6

	/// Number of departments (the company-level CEO unit is excluded)
	measure Departments = CALCULATE(DISTINCTCOUNT(DimEmployee[DepartmentID]), DimDepartment[DepartmentType] = "Department")
		formatString: 0
		displayFolder: Workforce
		lineageTag: c8853680-7fd2-4d10-be5c-e40642d8bf84

	/// Page header line: company, current employees and the reference date
	measure 'Text: Header Subtitle' = "Acme Corporation · " & FORMAT([Headcount], "0") & " current employees · as of " & FORMAT([Reference Date], "d mmm yyyy")
		displayFolder: Text
		lineageTag: 8bc23b69-7915-459a-b1e0-c12a57855cd1

	/// Navigation footer: data as of the reference date
	measure 'Text: Footer As Of' = "Data as of " & FORMAT([Reference Date], "d mmm yyyy")
		displayFolder: Text
		lineageTag: 00d74c33-981c-4e26-a914-e33a30653257

	/// KPI subtitle: CEO and department headcount
	measure 'Text: Headcount Split' = FORMAT([Headcount] - [Department Headcount], "0") & " CEO + " & FORMAT([Department Headcount], "0") & " in departments"
		displayFolder: Text
		lineageTag: a94730e9-b8d2-46ec-a47a-397f7b9ef44d

	/// KPI subtitle: youngest and oldest age
	measure 'Text: Age Range' = "Range " & FORMAT(MIN(DimEmployee[Age]), "0") & " to " & FORMAT(MAX(DimEmployee[Age]), "0")
		displayFolder: Text
		lineageTag: e0d8e33b-3f2e-4102-a8d2-a36dda9480a3

	/// Gender chart subtitle with the headcount in the current filter
	measure 'Text: Gender Subtitle' = "Share of all " & FORMAT([Headcount], "0") & " employees"
		displayFolder: Text
		lineageTag: 2c8594f7-3968-473c-84da-16c68a23a1b6

	/// Nationality chart subtitle
	measure 'Text: Nationality Subtitle' = "Top 6 of " & FORMAT(COUNTROWS(ALL(DimEmployee[Nationality])), "0") & " nationalities"
		displayFolder: Text
		lineageTag: 59427afd-85bc-4324-89ae-b8b997d9c610

	/// Native language chart subtitle
	measure 'Text: Language Subtitle' = "Top 6 of " & FORMAT(COUNTROWS(ALL(DimEmployee[NativeLanguage])), "0") & " languages"
		displayFolder: Text
		lineageTag: 0701d465-0444-4613-a868-d17207c4c55a

	/// Largest number of direct reports of any single manager
	measure 'Largest Span of Control' = MAX(DimEmployee[DirectReports])
		formatString: #,0
		displayFolder: Organization
		lineageTag: 5b1f6a0e-2c1d-4e7a-9a53-0d9c6e0f1a01

	/// Departments whose current headcount equals the planned target
	measure 'Departments at Target' = SUMX(FILTER(DimDepartment, DimDepartment[DepartmentType] = "Department"), IF([Headcount vs Target] = 0, 1, 0))
		formatString: #,0
		displayFolder: Organization
		lineageTag: 5b1f6a0e-2c1d-4e7a-9a53-0d9c6e0f1a02

	/// KPI subtitle: departments at target out of all departments
	measure 'Text: Departments at Target' = "of " & FORMAT(COUNTROWS(FactWorkforcePlan), "0") & " departments on plan"
		displayFolder: Text
		lineageTag: 5b1f6a0e-2c1d-4e7a-9a53-0d9c6e0f1a03

	/// KPI subtitle: the manager with the largest span
	measure 'Text: Teams with Largest Span' = ```
			
			VAR MaxSpan = [Largest Span of Control]
			VAR N =
			    CALCULATE ( COUNTROWS ( DimEmployee ), DimEmployee[DirectReports] = MaxSpan )
			RETURN
			    IF (
			        N = 1,
			        "1 team with size of ",
			        FORMAT ( N, "0" ) & " teams with size of"
			    )
			
			```
		displayFolder: Text
		lineageTag: 5b1f6a0e-2c1d-4e7a-9a53-0d9c6e0f1a04

	/// Average team size: direct reports per manager (a team = a manager's direct reports)
	measure 'Average Team Size' = DIVIDE([Direct Reports], [Managers])
		formatString: 0.0
		displayFolder: Organization
		lineageTag: 5b1f6a0e-2c1d-4e7a-9a53-0d9c6e0f1a05

	/// Job-history records that are career changes (excludes the Initial Assignment at hire)
	measure 'Career Events' = CALCULATE(COUNTROWS(FactJobHistory), KEEPFILTERS(FactJobHistory[ChangeType] <> "Initial Assignment"))
		formatString: #,0
		displayFolder: Career
		lineageTag: 1acf39d0-a826-4f8f-b5a5-d52fc92d22df

	/// Position changes without a promotion or department transfer
	measure 'Position Changes' = CALCULATE(COUNTROWS(FactJobHistory), FactJobHistory[ChangeType] = "Position Change")
		formatString: #,0
		displayFolder: Career
		lineageTag: 53467b9d-99fa-4abb-bd60-a2e8e7969c73

	/// Manager changes without a promotion, transfer or position change
	measure 'Manager Changes' = CALCULATE(COUNTROWS(FactJobHistory), FactJobHistory[ChangeType] = "Manager Change")
		formatString: #,0
		displayFolder: Career
		lineageTag: 05b661d7-f3eb-4b44-bfc8-56c17438e2f6

	/// Chart subtitle: the overall average months before a promotion
	measure 'Text: Months Before Promotion' = "Overall average " & FORMAT([Average Months Before Promotion], "0.0") & " months"
		displayFolder: Text
		lineageTag: 411869e0-64a1-498f-92df-89a35cf788e7

	/// Average salary increase at a promotion (share of the previous salary). Promotion and Promotion + Department Transfer both have the reason Promotion in the pay history.
	measure 'Average Promotion Increase' = DIVIDE(CALCULATE(AVERAGE(FactCompensation[ChangePct]), FactCompensation[Reason] = "Promotion"), 100)
		formatString: 0.0%
		displayFolder: Compensation
		lineageTag: 45460807-b759-4808-9877-2c21f9a99745

	/// Average yearly (1 January) salary increase (share of the previous salary), by the year the increase took effect.
	measure 'Average Annual Increase' = DIVIDE(CALCULATE(AVERAGE(FactCompensation[ChangePct]), FactCompensation[Reason] = "Annual Increase"), 100)
		formatString: 0.0%
		displayFolder: Compensation
		lineageTag: e5f66fe9-ab96-40ef-847e-f0e00428720a

	/// Average annual salary of the employees employed on 31 December of the selected year (reference date for the current year). Uses the salary period valid on that date; later years are blank.
	measure 'Average Salary at Year End' =
			VAR y = MAX(DimDate[Year])
			VAR d = MIN(DATE(y, 12, 31), [Reference Date])
			RETURN
			IF(y > YEAR([Reference Date]), BLANK(),
			    CALCULATE(
			        AVERAGEX(
			            FILTER(FactCompensation, FactCompensation[EffectiveDate] <= d && (ISBLANK(FactCompensation[EndDate]) || FactCompensation[EndDate] > d)),
			            FactCompensation[Salary]),
			        REMOVEFILTERS(DimDate)))
		formatString: "€"#,0
		displayFolder: Compensation
		lineageTag: 5fbd794b-1431-4885-a700-13b4e2fea72b

	/// Chart subtitle: number of promotions behind the average promotion increase.
	measure 'Text: Promotion Increase' = "Average per promotion, " & FORMAT(CALCULATE(COUNTROWS(FactCompensation), FactCompensation[Reason] = "Promotion"), "0") & " promotions"
		displayFolder: Text
		lineageTag: 4e82d702-3cb7-476f-b910-caf74defe9ee

	column Placeholder
		isHidden
		lineageTag: fea314cd-4a29-4eed-b760-804721d78b06
		isNameInferred
		sourceColumn: [Placeholder]

	partition _Measures = calculated
		mode: import
		source = DATATABLE("Placeholder", INTEGER, {{1}})

