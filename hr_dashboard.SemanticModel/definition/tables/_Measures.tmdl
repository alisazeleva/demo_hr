/// Holder table for the report measures (PLAN.md, Measures)
table _Measures
	lineageTag: 2c81652f-52f6-4669-b165-de60bf05f204

	/// The reference date (today), read from vw_ReferenceDate
	measure 'Reference Date' = MAX(ReferenceDate[ReferenceDate])
		formatString: yyyy-mm-dd
		displayFolder: Helpers
		lineageTag: 07cf75f8-b983-417e-b34b-f805ad62582c

	/// Number of employees in the current filter (151 in total, including the CEO)
	measure Headcount = COUNTROWS(DimEmployee)
		formatString: #,0
		displayFolder: Workforce
		lineageTag: 4c3dcaba-f1fe-4874-95ad-34c37f0a5b62

	/// Employees in the five departments (excludes the CEO, who sits under Acme Corporation)
	measure 'Department Headcount' = CALCULATE([Headcount], DimPosition[JobLevel] <> "CEO")
		formatString: #,0
		displayFolder: Workforce
		lineageTag: a66e7598-dcde-4a1e-9d33-cdf175145b22

	/// Planned headcount of the departments in the current employee filter (from the workforce plan; the CEO unit has no target).
	measure 'Target Headcount' =
			// FactWorkforcePlan is keyed by department; TREATAS applies the departments
			// that are visible through the current DimEmployee filter.
			CALCULATE(
			    SUM(FactWorkforcePlan[TargetHeadcount]),
			    TREATAS(VALUES(DimEmployee[DepartmentID]), FactWorkforcePlan[DepartmentID])
			)
		formatString: #,0
		displayFolder: Workforce
		lineageTag: 2aba32ae-24ca-4e58-af91-3986e603831d

	/// Target headcount minus department headcount: positive = below target (open positions), 0 = on target, negative = above target.
	measure 'Headcount vs Target' =
			// Target minus actual (not actual minus target): Technology 48 - 45 = +3
			[Target Headcount] - [Department Headcount]
		formatString: 0
		displayFolder: Workforce
		lineageTag: 6469f3eb-bd7d-4c2d-98f1-b3f907a58a5c

	/// Average years of service on the reference date
	measure 'Average Tenure (years)' = AVERAGE(DimEmployee[TenureYears])
		formatString: 0.0" years"
		displayFolder: Workforce
		lineageTag: c7bc268b-c549-4704-9dac-63db9c3a18e1

	/// Direct reports of the employees in the current filter
	measure 'Direct Reports' = SUM(DimEmployee[DirectReports])
		formatString: #,0
		displayFolder: Organization
		lineageTag: 103fef50-1b53-48ac-9109-d1adeac79706

	/// Employees who have at least one direct report
	measure Managers = CALCULATE(COUNTROWS(DimEmployee), DimEmployee[DirectReports] > 0)
		formatString: #,0
		displayFolder: Organization
		lineageTag: 82f235cb-b0fb-4738-bd4b-1562b6704e09

	/// Promotions (including promotions with a department transfer), by promotion date
	measure Promotions = CALCULATE(COUNTROWS(FactJobHistory), FactJobHistory[IsPromotion] = TRUE())
		formatString: #,0
		displayFolder: Career
		lineageTag: 16d7bda0-12ae-4323-b134-03d6d9a90b52

	/// Department transfers (including promotions with a transfer), by transfer date
	measure 'Department Transfers' = CALCULATE(COUNTROWS(FactJobHistory), FactJobHistory[IsDepartmentTransfer] = TRUE())
		formatString: #,0
		displayFolder: Career
		lineageTag: 0c5d85b3-28b0-4887-af77-3e7ff8c97f83

	/// Average months in the job before a promotion: from the previous promotion, or from hire for a first promotion, to the promotion date. Every promoted employee contributes, so every department has a value.
	measure 'Average Months Before Promotion' =
			// One value per promotion: months in the job before the promotion, counted from the
			// previous promotion or, for a first promotion, from the hire date (first job-history record).
			// Every promoted employee contributes, so every department has a value.
			AVERAGEX(
			    FILTER(FactJobHistory, FactJobHistory[IsPromotion] = TRUE()),
			    VAR emp = FactJobHistory[EmployeeID]
			    VAR promotionDate = FactJobHistory[EffectiveDate]
			    VAR previousPromotion =
			        CALCULATE(
			            MAX(FactJobHistory[EffectiveDate]),
			            FILTER(
			                ALL(FactJobHistory),
			                FactJobHistory[EmployeeID] = emp
			                    && FactJobHistory[IsPromotion] = TRUE()
			                    && FactJobHistory[EffectiveDate] < promotionDate
			            )
			        )
			    VAR hired =
			        CALCULATE(
			            MIN(FactJobHistory[EffectiveDate]),
			            FILTER(ALL(FactJobHistory), FactJobHistory[EmployeeID] = emp)
			        )
			    RETURN
			        DATEDIFF(IF(ISBLANK(previousPromotion), hired, previousPromotion), promotionDate, MONTH)
			)
		formatString: 0.0
		displayFolder: Career
		lineageTag: a660e71a-128b-4fcb-92d7-c6b25abf770e

	/// Average current annual base salary (EUR)
	measure 'Average Salary' = AVERAGE(DimEmployee[CurrentSalary])
		formatString: "€"#,0
		displayFolder: Compensation
		lineageTag: ea466c53-7b19-44a5-a489-79c622e6a087

	/// Average annual review rating (1.0 to 5.0)
	measure 'Average Rating' = AVERAGE(FactReviews[Rating])
		formatString: 0.00
		displayFolder: Performance
		lineageTag: d7a4de2f-ba41-4413-982c-0841b7ce1fb8

	/// Employees with no review in the 12 months before the reference date (includes the CEO and recent hires)
	measure 'Employees Without Recent Review' =
			// Recent = a review dated within the 12 months before the reference date.
			// Employees without any review (the CEO, recent hires) are counted too.
			VAR ref = [Reference Date]
			RETURN
			    CALCULATE(
			        COUNTROWS(DimEmployee),
			        FILTER(
			            DimEmployee,
			            ISBLANK(DimEmployee[LatestReviewDate])
			                || DimEmployee[LatestReviewDate] <= EDATE(ref, -12)
			        )
			    )
		formatString: #,0
		displayFolder: Performance
		lineageTag: 7b9fc68c-9e17-49be-b01a-85f7de1feaea

	/// Working days of approved leave in the current filter (one row per day in FactLeaveDays). Includes booked future days; filter IsOnOrBeforeReferenceDate for days to date.
	measure 'Leave Days' = COUNTROWS(FactLeaveDays)
		formatString: #,0
		displayFolder: Leave
		lineageTag: aa90eb6a-37a6-496f-89b5-b6f7e2cc3911

	/// Approved vacation working days on or before the reference date (future booked vacation is not counted).
	measure 'Vacation Days Used' =
			CALCULATE(
			    COUNTROWS(FactLeaveDays),
			    DimLeaveType[LeaveType] = "Vacation",
			    FactLeaveDays[IsOnOrBeforeReferenceDate] = TRUE()
			)
		formatString: #,0
		displayFolder: Leave
		lineageTag: 786de8ef-8478-4196-928c-03e963678c90

	/// Vacation days used per employee in the selected year(s): used days divided by employees hired by the end of the period. Use with a Year slicer or axis.
	measure 'Vacation Days Used per Year' =
			// Numerator: vacation days used in the period of the filter context (Year on an axis or slicer).
			// Denominator: employees hired by the end of that period (an employee hired part-way
			// through the year counts as one full person).
			DIVIDE(
			    [Vacation Days Used],
			    CALCULATE(COUNTROWS(DimEmployee), DimEmployee[HireDate] <= MAX(DimDate[Date]))
			)
		formatString: 0.0
		displayFolder: Leave
		lineageTag: 9b6a589d-dd13-4b49-a9be-63f88bb77d21

	/// Employees on approved leave on the reference date (ignores the Date filter)
	measure 'Currently Absent' =
			// Distinct employees with an approved leave day on the reference date.
			// REMOVEFILTERS(DimDate) makes the measure ignore any Date or Year filter.
			VAR ref = [Reference Date]
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(FactLeaveDays[EmployeeID]),
			        REMOVEFILTERS(DimDate),
			        FactLeaveDays[LeaveDate] = ref
			    )
		formatString: #,0
		displayFolder: Leave
		lineageTag: fbf39e58-6728-45d7-b659-2b2ed02a282f

	/// Average age in years on the reference date
	measure 'Average Age' = AVERAGE(DimEmployee[Age])
		formatString: 0.0" years"
		displayFolder: Workforce
		lineageTag: c618d38d-15c1-4c5e-ba1f-3ee110dbc158

	/// Median current annual base salary (EUR)
	measure 'Median Salary' = MEDIAN(DimEmployee[CurrentSalary])
		formatString: "€"#,0
		displayFolder: Compensation
		lineageTag: 209e92d4-13dc-4356-8709-3e6ac9d27971

	/// Sum of current annual base salaries (EUR per year)
	measure 'Total Payroll' = SUM(DimEmployee[CurrentSalary])
		formatString: "€"#,0
		displayFolder: Compensation
		lineageTag: 8b0a6cbd-e159-4d2a-af1b-c5b08755935b

	/// Number of departments (the company-level CEO unit is excluded)
	measure Departments = CALCULATE(DISTINCTCOUNT(DimEmployee[DepartmentID]), DimDepartment[DepartmentType] = "Department")
		formatString: 0
		displayFolder: Workforce
		lineageTag: c8853680-7fd2-4d10-be5c-e40642d8bf84

	/// Page header line: company, current employees and the reference date
	measure 'Text: Header Subtitle' = "Acme Corporation · " & FORMAT([Headcount], "0") & " current employees · as of " & FORMAT([Reference Date], "d mmm yyyy")
		displayFolder: Text
		lineageTag: 8bc23b69-7915-459a-b1e0-c12a57855cd1

	/// Navigation footer: data as of the reference date
	measure 'Text: Footer As Of' = "Data as of " & FORMAT([Reference Date], "d mmm yyyy")
		displayFolder: Text
		lineageTag: 00d74c33-981c-4e26-a914-e33a30653257

	/// KPI subtitle: CEO and department headcount
	measure 'Text: Headcount Split' = FORMAT([Headcount] - [Department Headcount], "0") & " CEO + " & FORMAT([Department Headcount], "0") & " in departments"
		displayFolder: Text
		lineageTag: a94730e9-b8d2-46ec-a47a-397f7b9ef44d

	/// KPI subtitle: youngest and oldest age
	measure 'Text: Age Range' = "Range " & FORMAT(MIN(DimEmployee[Age]), "0") & " to " & FORMAT(MAX(DimEmployee[Age]), "0")
		displayFolder: Text
		lineageTag: e0d8e33b-3f2e-4102-a8d2-a36dda9480a3

	/// Gender chart subtitle with the headcount in the current filter
	measure 'Text: Gender Subtitle' = "Share of all " & FORMAT([Headcount], "0") & " employees"
		displayFolder: Text
		lineageTag: 2c8594f7-3968-473c-84da-16c68a23a1b6

	/// Nationality chart subtitle
	measure 'Text: Nationality Subtitle' = "Top 6 of " & FORMAT(COUNTROWS(ALL(DimEmployee[Nationality])), "0") & " nationalities"
		displayFolder: Text
		lineageTag: 59427afd-85bc-4324-89ae-b8b997d9c610

	/// Native language chart subtitle
	measure 'Text: Language Subtitle' = "Top 6 of " & FORMAT(COUNTROWS(ALL(DimEmployee[NativeLanguage])), "0") & " languages"
		displayFolder: Text
		lineageTag: 0701d465-0444-4613-a868-d17207c4c55a

	/// Largest number of direct reports of any single manager
	measure 'Largest Span of Control' = MAX(DimEmployee[DirectReports])
		formatString: #,0
		displayFolder: Organization
		lineageTag: 5b1f6a0e-2c1d-4e7a-9a53-0d9c6e0f1a01

	/// Departments whose current headcount equals the planned target
	measure 'Departments at Target' =
			// Counts the departments (not the CEO unit) whose headcount equals the plan.
			// Headcount vs Target is evaluated per department row; 0 means on target.
			SUMX(
			    FILTER(DimDepartment, DimDepartment[DepartmentType] = "Department"),
			    IF([Headcount vs Target] = 0, 1, 0)
			)
		formatString: #,0
		displayFolder: Organization
		lineageTag: 5b1f6a0e-2c1d-4e7a-9a53-0d9c6e0f1a02

	/// KPI subtitle: departments at target out of all departments
	measure 'Text: Departments at Target' = "of " & FORMAT(COUNTROWS(FactWorkforcePlan), "0") & " departments on plan"
		displayFolder: Text
		lineageTag: 5b1f6a0e-2c1d-4e7a-9a53-0d9c6e0f1a03

	/// KPI subtitle: the manager with the largest span
	measure 'Text: Teams with Largest Span' =
			// Subtitle of the Largest team card. The card shows the number; this text explains it.
			// The 1-team text keeps its trailing space as originally written.
			VAR maxSpan = [Largest Span of Control]
			VAR managersWithMaxSpan =
			    CALCULATE(COUNTROWS(DimEmployee), DimEmployee[DirectReports] = maxSpan)
			RETURN
			    IF(
			        managersWithMaxSpan = 1,
			        "1 team with size of ",
			        FORMAT(managersWithMaxSpan, "0") & " teams with size of"
			    )
		displayFolder: Text
		lineageTag: 5b1f6a0e-2c1d-4e7a-9a53-0d9c6e0f1a04

	/// Average team size: direct reports per manager (a team = a manager's direct reports)
	measure 'Average Team Size' = DIVIDE([Direct Reports], [Managers])
		formatString: 0.0
		displayFolder: Organization
		lineageTag: 5b1f6a0e-2c1d-4e7a-9a53-0d9c6e0f1a05

	/// Job-history records that are career changes (excludes the Initial Assignment at hire)
	measure 'Career Events' =
			// KEEPFILTERS keeps the visual's own ChangeType filter (rows, legend or slicer)
			// instead of replacing it, so the measure can be split by change type.
			CALCULATE(
			    COUNTROWS(FactJobHistory),
			    KEEPFILTERS(FactJobHistory[ChangeType] <> "Initial Assignment")
			)
		formatString: #,0
		displayFolder: Career
		lineageTag: 1acf39d0-a826-4f8f-b5a5-d52fc92d22df

	/// Position changes without a promotion or department transfer
	measure 'Position Changes' = CALCULATE(COUNTROWS(FactJobHistory), FactJobHistory[ChangeType] = "Position Change")
		formatString: #,0
		displayFolder: Career
		lineageTag: 53467b9d-99fa-4abb-bd60-a2e8e7969c73

	/// Manager changes without a promotion, transfer or position change
	measure 'Manager Changes' = CALCULATE(COUNTROWS(FactJobHistory), FactJobHistory[ChangeType] = "Manager Change")
		formatString: #,0
		displayFolder: Career
		lineageTag: 05b661d7-f3eb-4b44-bfc8-56c17438e2f6

	/// Chart subtitle: the overall average months before a promotion
	measure 'Text: Months Before Promotion' = "Overall average " & FORMAT([Average Months Before Promotion], "0.0") & " months"
		displayFolder: Text
		lineageTag: 411869e0-64a1-498f-92df-89a35cf788e7

	/// Average salary increase at a promotion (share of the previous salary). Promotion and Promotion + Department Transfer both have the reason Promotion in the pay history.
	measure 'Average Promotion Increase' =
			// ChangePct is stored in percent (8.96 = 8.96 %), hence the division by 100.
			DIVIDE(
			    CALCULATE(AVERAGE(FactCompensation[ChangePct]), FactCompensation[Reason] = "Promotion"),
			    100
			)
		formatString: 0.0%
		displayFolder: Compensation
		lineageTag: 45460807-b759-4808-9877-2c21f9a99745

	/// Average yearly (1 January) salary increase (share of the previous salary), by the year the increase took effect.
	measure 'Average Annual Increase' =
			// ChangePct is stored in percent (3.03 = 3.03 %), hence the division by 100.
			DIVIDE(
			    CALCULATE(AVERAGE(FactCompensation[ChangePct]), FactCompensation[Reason] = "Annual Increase"),
			    100
			)
		formatString: 0.0%
		displayFolder: Compensation
		lineageTag: e5f66fe9-ab96-40ef-847e-f0e00428720a

	/// Average annual salary of the employees employed on 31 December of the selected year (reference date for the current year). Uses the salary period valid on that date; later years are blank.
	measure 'Average Salary at Year End' =
			// Salary period valid on 31 December of the selected year (the reference date for the current year).
			// The period test sits inside AVERAGEX: as a CALCULATE filter argument it would be evaluated
			// under the Year filter and see only the records that started in that year.
			VAR yearSelected = MAX(DimDate[Year])
			VAR asOf = MIN(DATE(yearSelected, 12, 31), [Reference Date])
			RETURN
			    IF(
			        yearSelected > YEAR([Reference Date]),
			        BLANK(),
			        CALCULATE(
			            AVERAGEX(
			                FILTER(
			                    FactCompensation,
			                    FactCompensation[EffectiveDate] <= asOf
			                        && (ISBLANK(FactCompensation[EndDate]) || FactCompensation[EndDate] > asOf)
			                ),
			                FactCompensation[Salary]
			            ),
			            REMOVEFILTERS(DimDate)
			        )
			    )
		formatString: "€"#,0
		displayFolder: Compensation
		lineageTag: 5fbd794b-1431-4885-a700-13b4e2fea72b

	/// Chart subtitle: number of promotions behind the average promotion increase.
	measure 'Text: Promotion Increase' = "Average per promotion, " & FORMAT(CALCULATE(COUNTROWS(FactCompensation), FactCompensation[Reason] = "Promotion"), "0") & " promotions"
		displayFolder: Text
		lineageTag: 4e82d702-3cb7-476f-b910-caf74defe9ee

	/// Number of employees on payroll on 31 December of the selected year (reference date for the current year). Shows how many people stand behind each point of Average Salary at Year End.
	measure 'Employees at Year End' =
			// Same period test as Average Salary at Year End (see the comment there): one salary
			// record is valid per employee on 31 December, so the row count is the headcount.
			VAR yearSelected = MAX(DimDate[Year])
			VAR asOf = MIN(DATE(yearSelected, 12, 31), [Reference Date])
			RETURN
			    IF(
			        yearSelected > YEAR([Reference Date]),
			        BLANK(),
			        CALCULATE(
			            COUNTROWS(
			                FILTER(
			                    FactCompensation,
			                    FactCompensation[EffectiveDate] <= asOf
			                        && (ISBLANK(FactCompensation[EndDate]) || FactCompensation[EndDate] > asOf)
			                )
			            ),
			            REMOVEFILTERS(DimDate)
			        )
			    )
		formatString: #,0
		displayFolder: Compensation
		lineageTag: 53564075-e921-4f33-b1ea-ee8716552a3b

	/// Number of annual performance reviews in the current filter (CEO has none).
	measure 'Number of Reviews' = COUNTROWS(FactReviews)
		formatString: #,0
		displayFolder: Performance
		lineageTag: 99e0bb0e-87b0-4871-812b-6b47a2bd9cbd

	/// Share of employees with a latest review whose latest level is Exceeds Expectations or Outstanding.
	measure 'Exceeds or Outstanding Share' =
			// Latest review level only; employees without a review are left out of the denominator.
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(DimEmployee),
			        DimEmployee[LatestPerformanceLevel] IN {"Exceeds Expectations", "Outstanding"}
			    ),
			    CALCULATE(COUNTROWS(DimEmployee), NOT ISBLANK(DimEmployee[LatestPerformanceLevel]))
			)
		formatString: 0%
		displayFolder: Performance
		lineageTag: 8850129e-2715-455d-9dab-9b2842a2cbf0

	/// Hex colour for the latest performance level of the employee (used for conditional formatting in the latest review table).
	measure 'Level Colour' =
			// Fill colour for the latest level of ONE employee (use on rows with a single employee).
			// Same palette as Review Level Colour.
			SWITCH(
			    SELECTEDVALUE(DimEmployee[LatestPerformanceLevel]),
			    "Outstanding", "#CFEFE9",
			    "Exceeds Expectations", "#D6E4FA",
			    "Meets Expectations", "#E5E7EB",
			    "Needs Improvement", "#F8D4DD",
			    "#FFFFFF"
			)
		displayFolder: Performance
		lineageTag: 5b1c84ed-16f6-44b6-aed8-f043b7752c27

	/// Subtitle of the latest review table: number of employees that have a latest review.
	measure 'Text: Latest Reviews' =
			FORMAT(
			    CALCULATE(COUNTROWS(DimEmployee), NOT ISBLANK(DimEmployee[LatestPerformanceLevel])),
			    "0"
			) & " employees with a latest review"
		displayFolder: Text
		lineageTag: e851c37a-fa5f-4cde-aa97-151b1d7e4c57

	/// Helper for the latest review table: 1 when the employee's latest performance level is among the levels selected in FactReviews[Level] (all levels when nothing is selected), otherwise 0. Used as a visual filter so a click on the rating distribution cross-filters the table.
	measure 'Latest Level in Selection' =
			// Visual filter (= 1) of the latest review table. FactReviews filters nothing in DimEmployee
			// (the relationship runs the other way), so the level selected in the rating distribution
			// chart is read here and compared with the employee's latest level.
			// ALLEXCEPT keeps only the Level and Level Long filters (either may be on the chart);
			// with nothing selected VALUES returns all levels and every employee passes.
			VAR latestLevel = SELECTEDVALUE(DimEmployee[LatestPerformanceLevel])
			VAR selectedLevels =
			    CALCULATETABLE(
			        VALUES(FactReviews[Level]),
			        ALLEXCEPT(FactReviews, FactReviews[Level], FactReviews[Level Long])
			    )
			RETURN
			    IF(latestLevel IN selectedLevels, 1, 0)
		formatString: 0
		isHidden
		displayFolder: Performance
		lineageTag: a3df9c8d-485a-47a5-83c1-fc6fffe1b4c7

	/// Approved leave working days from 1 January of the reference year up to the reference date, regardless of date filters.
	measure 'Leave Days YTD' =
			// 1 January of the reference year up to the reference date; ignores the Date filter.
			VAR ref = [Reference Date]
			RETURN
			    CALCULATE(
			        COUNTROWS(FactLeaveDays),
			        REMOVEFILTERS(DimDate),
			        FactLeaveDays[LeaveDate] >= DATE(YEAR(ref), 1, 1) && FactLeaveDays[LeaveDate] <= ref
			    )
		formatString: #,0
		displayFolder: Leave
		lineageTag: e896cfc5-cbd8-4f24-ba81-92dcb848d6df

	/// Approved vacation working days from 1 January of the reference year up to the reference date, divided by the current headcount.
	measure 'Vacation Days YTD per Employee' =
			// Vacation days from 1 January of the reference year up to the reference date,
			// divided by the headcount of the current filter; ignores the Date filter.
			VAR ref = [Reference Date]
			RETURN
			    DIVIDE(
			        CALCULATE(
			            COUNTROWS(FactLeaveDays),
			            REMOVEFILTERS(DimDate),
			            DimLeaveType[LeaveType] = "Vacation",
			            FactLeaveDays[LeaveDate] >= DATE(YEAR(ref), 1, 1) && FactLeaveDays[LeaveDate] <= ref
			        ),
			        [Headcount]
			    )
		formatString: 0.0
		displayFolder: Leave
		lineageTag: 86d19afa-d26a-47e9-b597-96f113119218

	/// Number of leave requests with status Pending (booked in the future, not yet approved).
	measure 'Pending Requests' = CALCULATE(COUNTROWS(FactLeaveRequests), FactLeaveRequests[Status] = "Pending")
		formatString: #,0
		displayFolder: Leave
		lineageTag: 209edb44-dadb-4b6d-b8b7-9e2b17812a64

	/// KPI subtitle for the year-to-date leave days.
	measure 'Text: Leave Days YTD' = "Approved, 1 Jan to " & FORMAT([Reference Date], "d mmm yyyy")
		displayFolder: Text
		lineageTag: f290eca6-f558-403d-a55b-85946e2379a9

	/// Subtitle of the absent-today table: number of employees on approved leave on the reference date.
	measure 'Text: Absent Today' = FORMAT([Currently Absent], "0") & " employees on approved leave on " & FORMAT([Reference Date], "d mmm yyyy")
		displayFolder: Text
		lineageTag: 72c2f23d-448e-4c7a-96d9-7eb126183f6c

	/// Name of the employee selected through drill-through (empty when none or several are selected).
	measure 'Text: Profile Name' = SELECTEDVALUE(DimEmployee[FullName], "No employee selected")
		displayFolder: Profile
		lineageTag: 0b6e55a0-0bc5-4213-9c82-ebb0ee0cd6a7

	/// Employee number of the selected employee (shown under the name in the profile header); a prompt to drill through when no employee is selected.
	measure 'Text: Profile Number' =
			VAR employeeNumber = SELECTEDVALUE(DimEmployee[EmployeeNumber])
			RETURN
			    IF(ISBLANK(employeeNumber), "Drill through from another page", employeeNumber)
		displayFolder: Profile
		lineageTag: 563576f2-ff98-44db-870c-449ce01c3fff

	/// Department of the selected employee (Acme Corporation for the CEO).
	measure 'Text: Profile Department' =
			// Looked up by key (the dimension does not receive the employee filter).
			COALESCE(
			    LOOKUPVALUE(DimDepartment[Department], DimDepartment[DepartmentID], SELECTEDVALUE(DimEmployee[DepartmentID])),
			    "-"
			)
		displayFolder: Profile
		lineageTag: 23383ddd-aafa-448a-aed7-e6784b5718ee

	/// Job level of the selected employee.
	measure 'Text: Profile Job Level' =
			// Looked up by key (the dimension does not receive the employee filter).
			VAR jobLevel =
			    LOOKUPVALUE(DimPosition[JobLevel], DimPosition[PositionID], SELECTEDVALUE(DimEmployee[PositionID]))
			RETURN
			    IF(ISBLANK(jobLevel), "", "Job level: " & jobLevel)
		displayFolder: Profile
		lineageTag: 22662e10-30a1-4222-9f53-630dbbee7cf1

	/// Direct manager of the selected employee.
	measure 'Text: Profile Manager' =
			// Looked up by key (the dimension does not receive the employee filter).
			// The CEO has no manager row, so the fallback text is shown for the CEO only.
			VAR managerName =
			    LOOKUPVALUE(DimManager[ManagerName], DimManager[ManagerEmployeeID], SELECTEDVALUE(DimEmployee[ManagerEmployeeID]))
			RETURN
			    IF(
			        ISBLANK(SELECTEDVALUE(DimEmployee[EmployeeNumber])),
			        "-",
			        COALESCE(managerName, "Reports to the board")
			    )
		displayFolder: Profile
		lineageTag: 49ea3f0b-d1f0-4e78-9569-305431fc38f6

	/// Tenure in years of the selected employee at the reference date.
	measure 'Text: Profile Tenure' =
			VAR tenureYears = SELECTEDVALUE(DimEmployee[TenureYears])
			RETURN
			    IF(ISBLANK(tenureYears), "-", FORMAT(tenureYears, "0.0") & " years")
		displayFolder: Profile
		lineageTag: 32e66b48-db9b-4a85-ae6b-170f8ea3c304

	/// Hire date of the selected employee.
	measure 'Text: Profile Hire Date' =
			VAR hireDate = SELECTEDVALUE(DimEmployee[HireDate])
			RETURN
			    IF(ISBLANK(hireDate), "", "Hired " & FORMAT(hireDate, "d mmm yyyy"))
		displayFolder: Profile
		lineageTag: 932e5e8d-f68d-4edf-a90b-b9205d8ba788

	/// Initials of the selected employee; shown in place of the profile picture until pictures exist.
	measure 'Text: Profile Initials' =
			// First letter of the first name and of the first word after the first space.
			VAR fullName = SELECTEDVALUE(DimEmployee[FullName])
			RETURN
			    IF(
			        ISBLANK(fullName),
			        "",
			        UPPER(LEFT(fullName, 1)) & UPPER(MID(fullName, FIND(" ", fullName & " ") + 1, 1))
			    )
		displayFolder: Profile
		lineageTag: 07ffa0ac-fbe2-4a21-ae3f-1b935ebb7872

	/// Annual base salary of the salary period (one value per salary record of the selected employee).
	measure 'Base Salary' = MAX(FactCompensation[Salary])
		formatString: "€"#,0
		displayFolder: Profile
		lineageTag: ff42e7dc-0820-48b7-af3a-40ca079de283

	/// Change of the salary record against the previous salary (share), for the tooltip of the salary history.
	measure 'Salary Change' = DIVIDE(MAX(FactCompensation[ChangePct]), 100)
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Profile
		lineageTag: 2864200f-2b11-4a78-a902-e2d61ba647c5

	/// Approved leave working days in the 24 months up to the reference date, by the selected filters.
	measure 'Leave Days Last 24 Months' =
			// The 24 months ending on the reference date (start date exclusive); ignores the Date filter.
			VAR ref = [Reference Date]
			RETURN
			    CALCULATE(
			        COUNTROWS(FactLeaveDays),
			        REMOVEFILTERS(DimDate),
			        FactLeaveDays[LeaveDate] > EDATE(ref, -24) && FactLeaveDays[LeaveDate] <= ref
			    )
		formatString: #,0
		displayFolder: Leave
		lineageTag: ed7f4f9c-ab8a-4d2c-b613-3219ed3c39da

	/// Position title of the selected employee (shown in the Position card of the profile header); a prompt to drill through when no employee is selected.
	measure 'Text: Profile Role' =
			// DimPosition filters DimEmployee, not the other way round, so the title is looked up by key.
			VAR position =
			    LOOKUPVALUE(DimPosition[PositionTitle], DimPosition[PositionID], SELECTEDVALUE(DimEmployee[PositionID]))
			RETURN
			    IF(ISBLANK(position), "Drill through from another page", position)
		displayFolder: Profile
		lineageTag: 6f9b8a1a-78c0-4ac7-9be0-ac65c25a59e0

	/// Current annual base salary of the selected employee, in EUR.
	measure 'Text: Profile Salary' =
			VAR salary = SELECTEDVALUE(DimEmployee[CurrentSalary])
			RETURN
			    IF(ISBLANK(salary), "-", "€" & FORMAT(salary, "#,0") & " / year")
		displayFolder: Profile
		lineageTag: 18c83a1c-5827-428a-9ee0-8517471ae695

	/// Subtitle of the salary card: the change and date of the current salary record.
	measure 'Text: Profile Salary Note' =
			// The current salary record: its change against the previous salary and its start date.
			// The first record (initial salary) has no change percentage.
			VAR currentRecord = CALCULATETABLE(FactCompensation, FactCompensation[IsCurrent] = TRUE())
			VAR changePct = MAXX(currentRecord, FactCompensation[ChangePct])
			VAR effectiveDate = MAXX(currentRecord, FactCompensation[EffectiveDate])
			RETURN
			    IF(
			        ISBLANK(effectiveDate),
			        "",
			        IF(
			            ISBLANK(changePct),
			            "Initial salary since hire",
			            FORMAT(changePct / 100, "+0.0%") & " on " & FORMAT(effectiveDate, "d mmm yyyy")
			        )
			    )
		displayFolder: Profile
		lineageTag: aa858aa7-1286-43c2-9c91-e6e318170cf2

	/// Latest review rating of the selected employee (scale 1 to 5).
	measure 'Text: Profile Rating' =
			VAR rating = SELECTEDVALUE(DimEmployee[LatestRating])
			RETURN
			    IF(
			        ISBLANK(SELECTEDVALUE(DimEmployee[EmployeeNumber])),
			        "-",
			        IF(ISBLANK(rating), "No review yet", FORMAT(rating, "0.0") & " / 5")
			    )
		displayFolder: Profile
		lineageTag: cbf64df5-460e-4011-9cb7-ae3364aad386

	/// Subtitle of the rating card: performance level and review year of the latest review.
	measure 'Text: Profile Rating Note' =
			VAR latestLevel = SELECTEDVALUE(DimEmployee[LatestPerformanceLevel])
			VAR reviewDate = SELECTEDVALUE(DimEmployee[LatestReviewDate])
			RETURN
			    IF(ISBLANK(latestLevel), "", latestLevel & " · " & FORMAT(reviewDate, "mmm yyyy"))
		displayFolder: Profile
		lineageTag: 019a6f54-3500-4a28-a452-c7f8879c2f70

	/// Hex colour for the performance level of each review row (same palette as Level Colour, which reads the latest level of the employee); used for conditional formatting of the review history table.
	measure 'Review Level Colour' =
			// Fill colour for the level of ONE review row (use on rows with a single review).
			// Same palette as Level Colour, which reads the employee's latest level instead.
			SWITCH(
			    SELECTEDVALUE(FactReviews[Level]),
			    "Outstanding", "#CFEFE9",
			    "Exceeds Expectations", "#D6E4FA",
			    "Meets Expectations", "#E5E7EB",
			    "Needs Improvement", "#F8D4DD",
			    "#FFFFFF"
			)
		displayFolder: Performance
		lineageTag: 5c588b49-b527-457b-9b22-7eb12a62ec68

	/// Disclaimer shown in the info pop-up on every page: the data is synthetic and the figures are as of the reference date
	measure 'Text: Info Note' =
			// Static disclaimer text plus the reference date, so the "as of" date follows the ReferenceDate table
			// and is formatted like the footer ("Data as of ..."). Used by the info panel on pages 1 to 7.
			"Demo report with fictional data. Acme Corporation and all employees are synthetic, generated for demonstration only, "
			    & "and any resemblance to real people is coincidental. Figures are as of "
			    & FORMAT([Reference Date], "d mmm yyyy") & "."
		displayFolder: Text
		lineageTag: 01f97653-b652-4988-bb6a-29df0e9bc453

	column Placeholder
		isHidden
		lineageTag: fea314cd-4a29-4eed-b760-804721d78b06
		isNameInferred
		sourceColumn: [Placeholder]

	partition _Measures = calculated
		mode: import
		source = DATATABLE("Placeholder", INTEGER, {{1}})

