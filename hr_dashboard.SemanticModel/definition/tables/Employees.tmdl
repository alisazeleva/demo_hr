	/// Rank of the nationality by headcount (1 = largest, ties by name); 99 = grouped into Other (outside the top 6)
	column 'Nationality Order' =
			VAR nat = Employees[Nationality]
			VAR counts = GROUPBY(ALL(Employees), Employees[Nationality], "@c", COUNTX(CURRENTGROUP(), 1))
			VAR cnt = MAXX(FILTER(counts, Employees[Nationality] = nat), [@c])
			VAR higher = COUNTROWS(FILTER(counts, [@c] > cnt || ([@c] = cnt && Employees[Nationality] < nat)))
			RETURN IF(higher < 6, higher + 1, 99)
		dataType: int64
		isHidden
		lineageTag: 94fa24ec-b5c6-4c2c-9208-e5cd4ab28487
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Rank of the native language by headcount (1 = largest, ties by name); 99 = grouped into Other (outside the top 6)
	column 'Native Language Order' =
			VAR lang = Employees[NativeLanguage]
			VAR counts = GROUPBY(ALL(Employees), Employees[NativeLanguage], "@c", COUNTX(CURRENTGROUP(), 1))
			VAR cnt = MAXX(FILTER(counts, Employees[NativeLanguage] = lang), [@c])
			VAR higher = COUNTROWS(FILTER(counts, [@c] > cnt || ([@c] = cnt && Employees[NativeLanguage] < lang)))
			RETURN IF(higher < 6, higher + 1, 99)
		dataType: int64
		isHidden
		lineageTag: dbea55b1-e6a6-4937-88ad-f9bad5191789
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Nationality for the six largest groups, everything else as Other
	column 'Nationality Top 6' = IF(Employees[Nationality Order] = 99, "Other (" & (COUNTROWS(ALL(Employees[Nationality])) - 6) & ")", Employees[Nationality])
		dataType: string
		lineageTag: e50a0bd0-cf11-4d6e-aa97-6485f31be90a
		summarizeBy: none
		sortByColumn: 'Nationality Order'

	/// Native language for the six largest groups, everything else as Other
	column 'Native Language Top 6' = IF(Employees[Native Language Order] = 99, "Other (" & (COUNTROWS(ALL(Employees[NativeLanguage])) - 6) & ")", Employees[NativeLanguage])
		dataType: string
		lineageTag: a7f33dd5-89ad-44ad-a707-49682f76a2e2
		summarizeBy: none
		sortByColumn: 'Native Language Order'

